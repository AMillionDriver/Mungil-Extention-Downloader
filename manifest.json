{
  "manifest_version": 3,
  "name": "TikTok Direct Downloader",
  "version": "1.0.0",
  "description": "Direct 1-click downloading of TikTok videos without third-party downloader websites or ads.",
  "permissions": [
    "downloads",
    "declarativeNetRequest",
    "storage",
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.byteoversea.com/*",
    "*://*.ibytedtos.com/*",
    "*://*.bilibili.tv/*",
    "*://*.bstation.tv/*",
    "*://*.biliapi.net/*",
    "*://*.jwplyr.com/*",
    "*://*.overfetch.video/*",
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.ytimg.com/*",
    "*://*.komiku.org/*",
    "*://*.komiku.id/*",
    "*://*.komiku.com/*",
    "*://*.komiku.co.id/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content/injected/tiktok_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content/platforms/tiktok.js"],
      "css": ["content/styles/tiktok.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.bilibili.tv/*", "*://*.bstation.tv/*"],
      "js": ["content/injected/bstation_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.bilibili.tv/*", "*://*.bstation.tv/*"],
      "js": ["content/platforms/bstation.js"],
      "css": ["content/styles/bstation.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.jwplyr.com/*"],
      "js": ["content/platforms/jwplyr.js"],
      "css": ["content/styles/jwplyr.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/injected/youtube_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/platforms/youtube.js"],
      "css": ["content/styles/youtube.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*/*",
        "*://*.jwplyr.com/*",
        "*://*.bilibili.tv/*",
        "*://*.bstation.tv/*",
        "*://*.youtube.com/*",
        "*://*.komiku.org/*",
        "*://*.komiku.id/*",
        "*://*.komiku.com/*",
        "*://*.komiku.co.id/*",
        "*://*.komiku.plus/*",
        "*://*.komiku.vip/*"
      ],
      "js": ["content/platforms/shield_listener.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*/*",
        "*://*.jwplyr.com/*",
        "*://*.bilibili.tv/*",
        "*://*.bstation.tv/*",
        "*://*.youtube.com/*",
        "*://*.komiku.org/*",
        "*://*.komiku.id/*",
        "*://*.komiku.com/*",
        "*://*.komiku.co.id/*",
        "*://*.komiku.plus/*",
        "*://*.komiku.vip/*"
      ],
      "js": ["content/injected/shield_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/injected/tiktok_bridge.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["*://*.tiktok.com/*"]
    },
    {
      "resources": [
        "content/injected/bstation_bridge.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["*://*.bilibili.tv/*", "*://*.bstation.tv/*"]
    },
    {
      "resources": [
        "content/injected/shield_bridge.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "*://*/*",
        "*://*.jwplyr.com/*",
        "*://*.komiku.org/*",
        "*://*.komiku.id/*",
        "*://*.komiku.com/*",
        "*://*.komiku.co.id/*",
        "*://*.komiku.plus/*",
        "*://*.komiku.vip/*"
      ]
    },
    {
      "resources": [
        "content/injected/youtube_bridge.js",
        "content/injected/shield_bridge.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TikTok Direct Downloader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
