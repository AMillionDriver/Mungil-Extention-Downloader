{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mungil-si-validator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "APP_STORAGE",
      "id": "51550627dd5d4b1a9b2aec57d70fc818"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}

