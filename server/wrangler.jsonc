{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mungil-si-validator",
  "account_id": "86b150f285e815616a0f9b9baa31f427",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "APP_STORAGE",
      "id": "5c6017751c5d46099227871f53590bce"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
